# Incremental objects in the existing table, loaded once by router reconcile.
table inet awg_geo {
    set cf_exit_dsts { type ipv4_addr; }

    chain cf_choose {
        ct mark { 0x41570201, 0x41570202 } meta mark set ct mark return
        ct mark != 0 return
        ct state != new return
        ct status confirmed return
        ip daddr @cf_exit_dsts counter ct mark set 0x41570202 meta mark set ct mark return
        counter ct mark set 0x41570201 meta mark set ct mark
    }
    chain cf_host {
        type route hook output priority mangle; policy accept;
        # Marked sockets include the per-tunnel probes, even when they query 1.1.1.1.
        meta mark 0 ct direction original ip daddr { 1.1.1.1, 1.0.0.1 } counter jump cf_choose
    }
    chain cf_dns {
        type filter hook prerouting priority mangle - 1; policy accept;
        iifname "@BRIDGE_IF@" ip saddr @DNS_IP@ meta mark 0 ct direction original ip daddr { 1.1.1.1, 1.0.0.1 } counter jump cf_choose
    }
    chain cf_snat {
        type nat hook postrouting priority srcnat - 3; policy accept;
        ct direction original ct mark 0x41570202 oifname "rn-ipip" ip daddr { 1.1.1.1, 1.0.0.1 } counter snat ip to 100.65.1.1
        ct direction original ct mark 0x41570202 oifname "rn-gre" ip daddr { 1.1.1.1, 1.0.0.1 } counter snat ip to 100.65.2.1
    }
}
