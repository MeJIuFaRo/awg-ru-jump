#!/usr/bin/python3
"""Apply independently validated datasets. Each nft change is one transaction."""
import datetime
import fcntl
import ipaddress
import json
import os
import secrets
import socket
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path("/var/lib/awg-geo")
LIB = Path("/usr/local/lib/awg-geo")
CONFIG = Path("/etc/awg-geo/mosdns.yaml")
FAMILY_TABLE = "inet awg_geo"
NFT = "/usr/sbin/nft"

def nft(script):
    subprocess.run([NFT, "-f", "-"], input=script, text=True, check=True)

def atomic_text(path, text):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as tmp:
        tmp.write(text)
        tmp.flush()
        os.fsync(tmp.fileno())
    os.replace(tmp.name, path)

def save_dns(periodic=False):
    path = ROOT / "dns-sets.json"
    if periodic and path.exists() and time.time() - path.stat().st_mtime < 300:
        return
    snapshot = {}
    for slot in ("a", "b"):
        result = subprocess.check_output([NFT, "-j", "list", "set", *FAMILY_TABLE.split(),
                                          "ru_dns_" + slot], text=True)
        record = next(item["set"] for item in json.loads(result)["nftables"] if "set" in item)
        snapshot[slot] = [str(ipaddress.IPv4Address(ip)) for ip in record.get("elem", [])]
    atomic_text(path, json.dumps(snapshot))

def restore_dns():
    path = ROOT / "dns-sets.json"
    if not path.exists():
        return
    snapshot = json.loads(path.read_text())
    commands = []
    for slot in ("a", "b"):
        entries = [str(ipaddress.IPv4Address(value)) for value in snapshot[slot]]
        for first in range(0, len(entries), 400):
            data = ", ".join(entries[first:first + 400])
            commands.append(f"add element {FAMILY_TABLE} ru_dns_{slot} {{ {data} }}")
    if commands:
        nft("\n".join(commands))

def load_geoip():
    path = ROOT / "geoip/current/rules.txt"
    networks = [ipaddress.IPv4Network(s) for s in path.read_text().splitlines() if s]
    if not networks:
        raise RuntimeError("Refuse to replace the active GeoIP set with no networks")
    commands = [f"flush set {FAMILY_TABLE} ru_nets"]
    for first in range(0, len(networks), 400):
        elements = ", ".join(map(str, networks[first:first + 400]))
        commands.append(f"add element {FAMILY_TABLE} ru_nets {{ {elements} }}")
    nft("\n".join(commands))

def dns_ready(host, port):
    # localhost. is answered by this Unbound independently of an external upstream.
    qid = secrets.token_bytes(2)
    packet = qid + bytes.fromhex("01000001000000000000") + b"\x09localhost\0\0\x01\0\x01"
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as client:
        client.settimeout(0.6)
        client.connect((host, port))
        client.send(packet)
        data = client.recv(4096)
    return len(data) >= 12 and data[:2] == qid and data[2] & 128 and data[3] & 15 == 0 and struct.unpack_from("!H", data, 6)[0] > 0

def await_dns(host, port, process=None):
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        if process is not None and process.poll() is not None:
            raise RuntimeError(f"Candidate DNS process exited with {process.returncode}")
        try:
            if dns_ready(host, port):
                return
        except OSError:
            pass
        time.sleep(0.15)
    raise RuntimeError(f"DNS listener {host}:{port} did not answer")

def apply_geosite():
    if not (ROOT / "geosite/current/rules.txt").stat().st_size:
        raise RuntimeError("Empty GeoSite matcher")
    # Load the candidate matcher in an isolated listener before touching active DNS.
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    with tempfile.TemporaryDirectory(prefix="awg-geo-check-", dir="/run") as work:
        cfg = Path(work) / "check.yaml"
        cfg.write_text(CONFIG.read_text().replace("@BRIDGE_GW@:1053", f"127.0.0.1:{port}"))
        proc = subprocess.Popen([LIB / "mosdns", "start", "-c", cfg, "-d", work])
        try:
            await_dns("127.0.0.1", port, proc)
        finally:
            if proc.poll() is None:
                proc.terminate()
            proc.wait(timeout=5)
    subprocess.run(["systemctl", "reset-failed", "awg-geo-dns.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "restart", "awg-geo-dns.service"], check=True)
    await_dns("@BRIDGE_GW@", 1053)

def rotate():
    state = ROOT / "dns-rotation.json"
    today = datetime.datetime.now(datetime.timezone.utc).date().isoformat()
    last = json.loads(state.read_text()) if state.exists() else {}
    if last.get("day") == today and last.get("done"):
        return
    slot = last["slot"] if last.get("day") == today else ("b" if last.get("slot") == "a" else "a")
    if slot not in ("a", "b"):
        raise ValueError("Invalid DNS rotation state")
    # After a crash retry the same slot. Both sets receive every fresh DNS result.
    atomic_text(state, json.dumps(dict(day=today, slot=slot, done=False)))
    nft(f"flush set {FAMILY_TABLE} ru_dns_{slot}\n")
    save_dns()
    atomic_text(state, json.dumps(dict(day=today, slot=slot, done=True)))
    print(f"Rotated DNS set ru_dns_{slot}")

def start_base():
    present = subprocess.run([NFT, "list", "table", "inet", "awg_geo"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not present:
        subprocess.run([NFT, "-f", LIB / "routing.nft"], check=True)
        restore_dns()
    load_geoip()

if __name__ == "__main__":
    actions = {"geoip": load_geoip, "geosite": apply_geosite, "rotate": rotate,
               "base-start": start_base, "snapshot": save_dns, "checkpoint": lambda: save_dns(periodic=True)}
    if sys.argv[1] in ("rotate", "base-start", "snapshot", "checkpoint"):
        with (ROOT / ".dns-checkpoint.lock").open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            actions[sys.argv[1]]()
    else:
        actions[sys.argv[1]]()
